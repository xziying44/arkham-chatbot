# =============================================================================
# 群聊机器人环境变量样例。复制为 .env 并填入真实值。
# =============================================================================

# ---- QQ 官方机器人 API v2 ----
# 见 https://bot.q.qq.com 后台「开发设置」
QQ_APP_ID=
QQ_APP_SECRET=
# 沙箱: https://sandbox.api.sgroup.qq.com  正式: https://api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com

# ---- LLM Provider（按你用的 provider 至少填一组）----
# pi-ai 会按 provider 自动解析 key，详见 @earendil-works/pi-ai 文档
# 智谱 BigModel（Anthropic 兼容端点，本机 Claude 同款配置）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# 其它可选 provider
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- 默认模型 ----
# 格式: <provider>/<model-id>
# 智谱 Anthropic 兼容端点示例: anthropic/glm-4.6
# 官方 Anthropic 示例: anthropic/claude-sonnet-4-5
CHATBOT_MODEL=anthropic/glm-4.6

# ---- 会话池 ----
# 无活动会话回收阈值（毫秒），默认 1 小时
CHATBOT_SESSION_TTL_MS=3600000
# 回收器扫描间隔（毫秒），默认 1 分钟
CHATBOT_REAPER_INTERVAL_MS=60000

# ---- 沙箱 ----
# 是否启用 Bubblewrap 隔离（仅 Linux 生效；其它平台自动回退 NodeExecutionEnv）
CHATBOT_SANDBOX_ENABLED=true
# 沙箱是否断网（防数据外泄）
CHATBOT_SANDBOX_NETWORK_DISABLED=true
# 单条 bash 命令默认超时（秒）
CHATBOT_SANDBOX_TIMEOUT_SECONDS=30

# ---- 数据目录 ----
CHATBOT_DATA_DIR=./data
# SQLite 数据库路径（机器人账号/设置/消息流水/日志），默认 <CHATBOT_DATA_DIR>/chatbot.db
CHATBOT_DB_PATH=

# ---- 技能 + arkham-workshop ----
# 技能源文件目录（每个子目录一个 SKILL.md），启动时加载注入所有会话的系统提示词
SKILLS_DIR=./skills
# arkham-workshop 项目根目录（推导 CLI 二进制 target/release/arkham-cli + assets/）
# 也可单独指定 ARKHAM_CLI_PATH 和 ARKHAM_ASSETS_DIR
ARKHAM_WORKSHOP_DIR=
# ARKHAM_CLI_PATH=
# ARKHAM_ASSETS_DIR=

# ---- 卡牌数据库（search_cards 工具用） ----
# 数据库目录（含 json/ + card_images/），配置后装配 search_cards 并只读挂载到沙箱 cards-db/
CHATBOT_CARD_DATABASE_DIR=

# ---- 卡组分享（import_deck / render_deck 工具）----
# 社区数据库 arkhamdb-json-data 根目录（卡组分类用标准字段 type_code/permanent/slot/restrictions）
CHATBOT_ARKHAMDB_DATA_DIR=/Users/xziying/project/arkham/社区数据库/arkhamdb-json-data
# 卡组分享渲染中文字体目录（需含 source-han-sans.ttf、hanyi-small-clerical-simple.ttf）
CHATBOT_DECK_FONTS_DIR=/Users/xziying/project/arkham/arkham-homebrew/fonts

# ---- MiniMax 文生图（generate_image 工具）----
# 配置后装配 generate_image 工具；key 只在宿主机进程内存，不进沙箱。
# 不配置则不装配该工具（优雅降级）。
MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimaxi.com

# ---- 管理端（Web 后台）----
# 监听地址，默认仅本机；如需远程访问改成 0.0.0.0（注意配合鉴权）
ADMIN_HOST=127.0.0.1
# 监听端口
ADMIN_PORT=5180
# admin-web 构建产物目录（生产部署时指向 packages/admin-web/dist）
ADMIN_WEB_DIST=
# 引导管理员用户名（仅首次启动种库用；之后在管理端「设置」里改）
ADMIN_USERNAME=admin
# 引导管理员密码（仅首次启动种库用；不填则默认 admin，强烈建议首次登录后立即改）
ADMIN_PASSWORD=

# =============================================================================
# 说明：
# - QQ_* / CHATBOT_MODEL / ANTHROPIC_* 等仅作 **首次启动的引导默认值**：
#   首次起库时若 DB 为空，用这些值种一条默认机器人 + 默认设置。
#   之后以 SQLite 为准，可在管理端动态增改（多机器人/换模型/改 persona）。
# - 启动: pnpm dev（开发）或 pnpm start（生产，需先 build）
# - 构建管理端前端: pnpm --filter @arkham/chatbot-admin-web build
#   然后设 ADMIN_WEB_DIST=<仓库>/packages/admin-web/dist 启动即同时服务管理端 UI
# =============================================================================

