# =============================================================================
# 群聊机器人环境变量样例。复制为 .env 并填入真实值。
# =============================================================================

# ---- QQ 官方机器人 API v2 ----
# 见 https://bot.q.qq.com 后台「开发设置」
QQ_APP_ID=
QQ_APP_SECRET=
# 沙箱: https://sandbox.api.sgroup.qq.com  正式: https://api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com

# ---- LLM Provider（按你用的 provider 至少填一组）----
# pi-ai 会按 provider 自动解析 key，详见 @earendil-works/pi-ai 文档
# 智谱 BigModel（Anthropic 兼容端点，本机 Claude 同款配置）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# 其它可选 provider
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- 默认模型 ----
# 格式: <provider>/<model-id>
# 智谱 Anthropic 兼容端点示例: anthropic/glm-4.6
# 官方 Anthropic 示例: anthropic/claude-sonnet-4-5
CHATBOT_MODEL=anthropic/glm-4.6

# ---- 会话池 ----
# 无活动会话回收阈值（毫秒），默认 1 小时
CHATBOT_SESSION_TTL_MS=3600000
# 回收器扫描间隔（毫秒），默认 1 分钟
CHATBOT_REAPER_INTERVAL_MS=60000

# ---- 沙箱 ----
# 是否启用 Bubblewrap 隔离（仅 Linux 生效；其它平台自动回退 NodeExecutionEnv）
CHATBOT_SANDBOX_ENABLED=true
# 沙箱是否断网（防数据外泄）
CHATBOT_SANDBOX_NETWORK_DISABLED=true
# 单条 bash 命令默认超时（秒）
CHATBOT_SANDBOX_TIMEOUT_SECONDS=30

# ---- 数据目录 ----
CHATBOT_DATA_DIR=./data
