{
  "name": "@arkham/deck-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "卡组分享渲染引擎 — 数据驱动的排班表(DekLayout) → PNG，可被智能体自由编排",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "cli": "tsx src/cli.ts",
    "stress": "tsx src/stress.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
